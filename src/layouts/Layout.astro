---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pitzil Avila-Castellanos: Humanitarian Technologist",
  description = "Portfolio of Pitzil Avila-Castellanos: humanitarian tech, offline-first infrastructure, and advocacy work spanning California legislature to Uganda.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="font-sans text-navy-950">
    <a href="#main" class="skip-link">Skip to main content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
