---
const navLinks = [
  { href: "/#about", label: "About" },
  { href: "/experience", label: "Experience" },
  { href: "/projects", label: "Projects" },
  { href: "/advocacy", label: "Advocacy" },
  { href: "/writing", label: "Writing" },
  { href: "/awards", label: "Awards" },
  { href: "/press", label: "Press" },
  { href: "/resume", label: "Resume" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-navy-950/95 backdrop-blur text-ivory-100 border-b border-sage-700/40">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-4">
    <a
      href="/"
      class="font-display text-lg font-semibold tracking-wide text-ivory-50 hover:text-sage-300"
    >
      Pitzil Avila-Castellanos
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {
          navLinks.map((link) => {
            const isCurrent = currentPath === link.href;
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={[
                    "inline-flex min-h-11 items-center border-b-2 text-ivory-100 hover:text-sage-300",
                    isCurrent
                      ? "border-sage-300 font-bold text-sage-300"
                      : "border-transparent",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
