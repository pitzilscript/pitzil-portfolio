---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
  { href: "/",           label: "About" },
  { href: "/advocacy",   label: "Advocacy" },
  { href: "/work",       label: "Work" },
  { href: "/writing",    label: "Writing" },
  { href: "/recognition",label: "Recognition" },
];
---

<header class="site-header">
  <a href="#main-content" class="skip-link">Skip to content</a>

  <a href="/" class="brand" aria-label="Pitzil Avila-Castellanos — home">
    <span class="brand-monogram" aria-hidden="true">PA</span>
    <strong>Pitzil Avila-Castellanos</strong>
  </a>

  <nav class="header-nav" aria-label="Main navigation">
    {navLinks.map(({ href, label }) => {
      const isCurrent =
        href === "/"
          ? currentPath === "" || currentPath === "/"
          : currentPath === href || currentPath.startsWith(href + "/");
      return (
        <a href={href} aria-current={isCurrent ? "page" : undefined}>
          {label.toUpperCase()}
        </a>
      );
    })}
  </nav>

  <div class="header-actions">
    <a href="/contact" class="header-contact">
      Let's connect
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</header>
