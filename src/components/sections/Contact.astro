---
---

<div class="tab-panel" id="main-content">
  <div class="contact-layout reveal">
    <div>
      <div class="section-intro">
        <p class="eyebrow">Contact</p>
        <h2>Let's build<br/>something real.</h2>
        <p>
          I'm open to conversations about humanitarian technology, engineering roles, graduate research, and advocacy partnerships. If you're working on something that widens access, I want to hear about it.
        </p>
      </div>

      <div class="availability">
        <span aria-hidden="true"></span>
        Available for opportunities starting 2027
      </div>

      <div style="margin-top: 36px; display: flex; flex-direction: column; gap: 14px; max-width: 340px;">
        <a
          href="https://www.linkedin.com/in/pitzil"
          class="primary-button"
          target="_blank"
          rel="noopener noreferrer"
          style="justify-content: center;"
        >
          Connect on LinkedIn
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M7 2.5L11.5 7 7 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href="https://github.com/pitzilscript"
          class="secondary-button"
          target="_blank"
          rel="noopener noreferrer"
          style="justify-content: center; display: flex; align-items: center; gap: 8px;"
        >
          View GitHub
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M7 2.5L11.5 7 7 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="contact-card">
      <div class="contact-orbit orbit-one" aria-hidden="true"></div>
      <div class="contact-orbit orbit-two" aria-hidden="true"></div>

      <div class="contact-card-content">
        <div class="icon-tile light large" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M3 5h14v10H3z" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linejoin="round"/>
            <path d="M3 5l7 6 7-6" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
          </svg>
        </div>

        <h3>Let's get in touch.</h3>
        <p>
          The fastest way to reach me is LinkedIn or email. I try to respond to every message.
        </p>

        <a href="mailto:pcastellanos24@apu.edu" class="contact-email">
          <span>pcastellanos24@apu.edu</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M7 2.5L11.5 7 7 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <div class="social-row">
          <a href="https://www.linkedin.com/in/pitzil" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-label="LinkedIn">
              <path d="M3 5.5H1V13h2V5.5zm-1-4a1.25 1.25 0 110 2.5A1.25 1.25 0 012 1.5zM13 13h-2V9c0-.75-.25-1.25-1-1.25-.75 0-1.25.5-1.25 1.25V13H6.5V5.5H8.5v1C9 5.75 10 5 11 5c1.5 0 2 1 2 2.5V13z"/>
            </svg>
            LinkedIn
          </a>
          <a href="https://github.com/pitzilscript" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-label="GitHub">
              <path d="M7 .5A6.5 6.5 0 00.5 7c0 2.9 1.88 5.35 4.5 6.22.33.06.45-.14.45-.31v-1.1C3.63 12.3 3.25 11 3.25 11c-.3-.76-.73-.96-.73-.96-.6-.41.04-.4.04-.4.66.05 1 .68 1 .68.6 1.02 1.56.73 1.94.56.06-.43.23-.73.42-.9-1.48-.17-3.04-.74-3.04-3.3 0-.73.26-1.33.68-1.8-.07-.17-.3-.85.06-1.77 0 0 .56-.18 1.83.68A6.3 6.3 0 017 4.09c.56 0 1.13.08 1.66.22 1.27-.86 1.83-.68 1.83-.68.36.92.13 1.6.06 1.77.42.47.68 1.07.68 1.8 0 2.57-1.57 3.13-3.05 3.3.24.2.45.62.45 1.25v1.84c0 .17.12.38.45.31A6.5 6.5 0 0013.5 7 6.5 6.5 0 007 .5z"/>
            </svg>
            GitHub
          </a>
          <a href="https://pitzil.dev" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-label="Website">
              <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2" fill="none"/>
              <path d="M1 7h12M7 1C5.5 3.5 5 5.5 5 7s.5 3.5 2 6M7 1c1.5 2.5 2 4.5 2 6s-.5 3.5-2 6" stroke="currentColor" stroke-width="1.2"/>
            </svg>
            pitzil.dev
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
