---
import { Image } from "astro:assets";
import awardsBg from "../../assets/photos/place-pasadena.jpg";

const awards = [
  {
    title: "Girl Scout Gold Award & Lifetime Member",
    body: "For translating a court-mandated training manual into Spanish and building mental health resources for youth in foster care. Full story on the Advocacy page.",
    href: "/advocacy",
    youtube: "https://www.youtube.com/watch?v=5DXfsqlR-WM",
  },
  {
    title: "APU Trustees Scholar",
    body: "Awarded for a 4.22 GPA and Valedictorian status at Walnut High School.",
  },
  {
    title: "Hispanic Information Technology Executive Council (HITEC) Scholar",
    body: "Selected for academic and vocational excellence.",
  },
  {
    title: "Linux Foundation Inclusivity Scholar",
    body: "Selected to attend Open Source Summit North America 2026.",
  },
  {
    title: "Seal of Biliteracy in Spanish",
    body: "Recognized for proficiency in both Spanish and English.",
  },
  {
    title: "Valedictorian, Walnut High School",
    body: "Graduated at the top of my class.",
  },
];

// Ordered newest to oldest. Several items don't have an exact recorded
// date; those are placed at their most likely year based on context
// (e.g. senior-year scholarships clustered at 2025 graduation).
const fullAwards = [
  "Class of 2025 Valedictorian",
  "PLTW Computer Science Pathway Graduate",
  "PLTW Computer Science Service and Leadership",
  "Seal of Biliteracy in Spanish",
  "WHS ASB Hall of Fame",
  "ACSA Region 12 Scholarship",
  "WHS Track & Field Captains Award",
  "WHS Track & Field Hurdles Coach's Award",
  "Los Angeles Top 7 Positive Athlete",
  "WHS Latin Parent Alliance Scholarship",
  "Walnut Valley Kiwanis Club Award (Leadership)",
  "AP Spanish Outstanding Student",
  "Born 2 Win Foundation Scholarship",
  "Women of AT&T Scholarship",
  "WHS Highest Honors Student",
  "Walnut Valley Women's Club Scholarship",
  "Ken Gunn Scholarship",
  "APU Trustees Award",
  "Girl Scout Gold, Silver, and Bronze Awards",
  "Bithiah's Outstanding Volunteer (2024)",
  "2024 Hacienda All-League Scholar Athlete",
  "WHS ASB Most Valuable Member (2024)",
  "WHS Track & Field Third Year Award",
  "2023 National Hispanic Recognition (College Board)",
  "WHS ASB Rookie of the Year (2023)",
  "1st Place, 2022 Walnut Valley Water District Media Contest",
  "Finalist, 2021 Rose Parade Día de los Muertos Art Competition",
  "4-Year California Junior Scholarship Federation Member",
];

// Ordered by start year, newest to oldest.
const fullExtracurriculars = [
  "UC Riverside MEChA Leadership Camp (2024)",
  "SheCodes Future Women Developers Conference (2024)",
  "Advocacy for State Legislature (2023–2025)",
  "Student Think Tank (2023–2025)",
  "Foster First — Secretary (2023–2024)",
  "University of Michigan Sisters Rise Up (2023–2025)",
  "Associated Student Body — President (2024–2025), Rallies Commissioner, Pride and Spirit Commissioner (2022–2025)",
  "Latin Student Alliance — Historian, Founding Member (2022–2025)",
  "Track and Field — Team Captain, Social Media Manager (2021–2025)",
  "Class Cabinet (2021–2025)",
  "Redeemed Life Church — Media Ministry, Youth Group Leader (2020–2025)",
  "Bithiah's Family Services (2014–Present)",
  "Girl Scouts (2012–Present)",
];
---

<section class="relative overflow-hidden">
  <Image
    src={awardsBg}
    alt=""
    widths={[800, 1600, 2400]}
    sizes="100vw"
    data-parallax
    class="absolute inset-0 h-full w-full object-cover object-[50%_30%] grayscale blur-[1px]"
  />
  <div
    class="absolute inset-0"
    style="background-color: rgba(250, 247, 238, 0.8);"
  ></div>

  <div class="relative mx-auto max-w-3xl px-6 py-20">
    <h1 class="reveal font-display text-3xl font-normal text-navy-950">Awards</h1>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        awards.map((award, i) => (
          <div class={`reveal card-lift rounded-xl border border-navy-950/15 bg-white p-6${i % 2 === 1 ? " reveal-d2" : ""}`}>
            <h2 class="font-display text-lg font-normal text-navy-950">
              {award.href ? (
                <a
                  href={award.href}
                  class="hover:text-sage-500"
                >
                  {award.title}
                </a>
              ) : (
                award.title
              )}
            </h2>
            <p class="mt-2 text-sm text-navy-800">{award.body}</p>
            {award.youtube && (
              <a
                href={award.youtube}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-block text-sm text-sage-700 underline decoration-sage-500 underline-offset-2 hover:text-navy-950"
              >
                Watch on YouTube ↗
              </a>
            )}
          </div>
        ))
      }
    </div>

    <details class="group mt-8 rounded-xl border border-navy-950/15 bg-white p-6">
      <summary class="cursor-pointer list-none font-display text-lg font-normal text-navy-950 [&::-webkit-details-marker]:hidden">
        See all awards, honors, and leadership
        <span class="ml-1 inline-block transition-transform group-open:rotate-180">▾</span>
      </summary>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        <div>
          <h3 class="font-display text-base font-normal text-navy-950">
            Awards &amp; Honors
          </h3>
          <ul class="mt-3 space-y-2 text-sm text-navy-800">
            {fullAwards.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="font-display text-base font-normal text-navy-950">
            Extracurricular &amp; Leadership
          </h3>
          <ul class="mt-3 space-y-2 text-sm text-navy-800">
            {fullExtracurriculars.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </details>
  </div>
</section>
