---

<div class="tab-panel" id="main-content">
  <div class="section-intro reveal">
    <p class="eyebrow">Recognition</p>
    <h2>Honors &amp;<br/>distinctions.</h2>
    <p>
      Awards, scholarships, and press recognition for engineering, advocacy, and community work.
    </p>
  </div>

  <div class="recognition-grid reveal">

    <!-- 01: Linux Foundation -->
    <div class="recognition-card featured reveal">
      <p>01 &middot; 2026</p>
      <h3>Linux Foundation Inclusivity Scholar</h3>
      <span class="award-sub">Open Source Summit North America 2026</span>
      <div class="award-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M9 2l2.47 5.26 5.53.8-4 3.9.94 5.52L9 14.77l-4.94 2.71.94-5.52-4-3.9 5.53-.8z" stroke="currentColor" stroke-width="1.3" fill="none"/>
        </svg>
      </div>
    </div>

    <!-- 02: Gold Award -->
    <div class="recognition-card featured reveal reveal-d1">
      <p>02 &middot; Girl Scouts</p>
      <h3>Girl Scout Gold Award &amp; Lifetime Member</h3>
      <span class="award-sub">For translating a court-mandated training manual into Spanish and building mental health resources for youth in foster care.</span>
      <div class="award-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M9 2l2.47 5.26 5.53.8-4 3.9.94 5.52L9 14.77l-4.94 2.71.94-5.52-4-3.9 5.53-.8z" stroke="currentColor" stroke-width="1.3" fill="none"/>
        </svg>
      </div>
    </div>

    <!-- 03: HITEC -->
    <div class="recognition-card featured reveal reveal-d2">
      <p>03 &middot; HITEC</p>
      <h3>HITEC Scholar</h3>
      <span class="award-sub">Hispanic Information Technology Executive Council &mdash; selected for academic and vocational excellence.</span>
      <div class="award-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M9 2l2.47 5.26 5.53.8-4 3.9.94 5.52L9 14.77l-4.94 2.71.94-5.52-4-3.9 5.53-.8z" stroke="currentColor" stroke-width="1.3" fill="none"/>
        </svg>
      </div>
    </div>

    <!-- 04: APU Trustees -->
    <div class="recognition-card featured reveal">
      <p>04 &middot; Azusa Pacific University</p>
      <h3>APU Trustees Scholar</h3>
      <span class="award-sub">Awarded for a 4.22 GPA and Valedictorian status at Walnut High School.</span>
      <div class="award-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M9 2L2 6l7 4 7-4-7-4z" stroke="currentColor" stroke-width="1.3" fill="none"/>
          <path d="M2 6v6l7 4 7-4V6" stroke="currentColor" stroke-width="1.3" fill="none"/>
        </svg>
      </div>
    </div>

    <!-- 05: Valedictorian -->
    <div class="recognition-card featured reveal reveal-d1">
      <p>05 &middot; Walnut High School</p>
      <h3>Valedictorian</h3>
      <span class="award-sub">Graduated at the top of my class. Seal of Biliteracy in Spanish.</span>
      <div class="award-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M3 9h12M3 5h12M3 13h8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
      </div>
    </div>

    <!-- 06: IOY Ambassador -->
    <div class="recognition-card featured reveal reveal-d2">
      <p>06 &middot; 2026&ndash;2027</p>
      <h3>IOY Ambassador</h3>
      <span class="award-sub">International Organization for Youth &mdash; 2026&ndash;2027 cycle.</span>
      <div class="award-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.3" fill="none"/>
          <path d="M9 5v4l3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
      </div>
    </div>

  </div><!-- /recognition-grid -->

  <!-- See all awards dropdown -->
  <details class="see-all-awards">
    <summary class="see-all-summary">
      <span>See all awards, honors &amp; leadership</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3.5 5.5l3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div class="see-all-body">
      <div>
