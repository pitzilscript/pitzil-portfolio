    title: "Girl Scout Gold Award & Lifetime Member",
    body: "For translating a court-mandated training manual into Spanish and building mental health resources for youth in foster care.",
    href: "https://www.girlscouts.org/en/members/for-girl-scouts/badges-journeys-awards/highest-awards/gold-award.html",
    external: true,
    advocacy: "/advocacy",
    youtube: "https://www.youtube.com/watch?v=5DXfsqlR-WM",
  },
  {
    title: "Linux Foundation Inclusivity Scholar",
    body: "Selected to attend Open Source Summit North America 2026.",
    href: "https://events.linuxfoundation.org/open-source-summit-north-america/attend/scholarships/",
    external: true,
  },
  {
    title: "Hispanic Information Technology Executive Council (HITEC) Scholar",
    body: "Selected for academic and vocational excellence.",
    href: "https://hitecglobal.org/foundation",
    external: true,
  },
  {
    title: "APU Trustees Scholar",
    body: "Awarded for a 4.22 GPA and Valedictorian status at Walnut High School.",
    href: "https://www.apu.edu/articles/nine-students-earn-full-tuition-trustees-scholarships/",
    external: true,
  },
  {
    title: "Seal of Biliteracy in Spanish",
    body: "Recognized for proficiency in both Spanish and English.",
    href: "https://sealofbiliteracy.org/",
    external: true,
  },
  {
    title: "Valedictorian, Walnut High School",
    body: "Graduated at the top of my class.",
  },
];

const fullAwards = [
  { label: "Class of 2025 Valedictorian" },
  { label: "PLTW Computer Science Pathway Graduate" },
  { label: "PLTW Computer Science Service and Leadership" },
  { label: "Seal of Biliteracy in Spanish", href: "https://sealofbiliteracy.org/" },
  { label: "WHS ASB Hall of Fame" },
  { label: "ACSA Region 12 Scholarship" },
  { label: "WHS Track & Field Captains Award" },
  { label: "WHS Track & Field Hurdles Coach's Award" },
  { label: "Los Angeles Top 7 Positive Athlete" },
  { label: "WHS Latin Parent Alliance Scholarship" },
  { label: "Walnut Valley Kiwanis Club Award (Leadership)" },
  { label: "AP Spanish Outstanding Student" },
  { label: "Born 2 Win Foundation Scholarship" },
  { label: "Women of AT&T Scholarship" },
  { label: "WHS Highest Honors Student" },
  { label: "Walnut Valley Women's Club Scholarship" },
  { label: "Ken Gunn Scholarship" },
  { label: "APU Trustees Award", href: "https://www.apu.edu/articles/nine-students-earn-full-tuition-trustees-scholarships/" },
  { label: "Girl Scout Gold, Silver, and Bronze Awards", href: "https://www.girlscouts.org/en/members/for-girl-scouts/badges-journeys-awards/highest-awards/gold-award.html" },
  { label: "Bithiah's Outstanding Volunteer (2024)" },
  { label: "2024 Hacienda All-League Scholar Athlete" },
  { label: "WHS ASB Most Valuable Member (2024)" },
  { label: "WHS Track & Field Third Year Award" },
  { label: "2023 National Hispanic Recognition (College Board)", href: "https://cb.collegeboard.org/students/hispanic-recognition" },
  { label: "WHS ASB Rookie of the Year (2023)" },
  { label: "1st Place, 2022 Walnut Valley Water District Media Contest", href: "https://www.walnuths.net/apps/news/article/1764266" },
  { label: "Finalist, 2021 Rose Parade Día de los Muertos Art Competition" },
  { label: "4-Year California Junior Scholarship Federation Member", href: "https://www.cjsf.org/" },
];

const fullExtracurriculars = [
  "UC Riverside MEChA Leadership Camp (2024)",
  "SheCodes Future Women Developers Conference (2024)",
  "Advocacy for State Legislature (2023–2025)",
  "Student Think Tank (2023–2025)",
  "Foster First — Secretary (2023–2024)",
  "University of Michigan Sisters Rise Up (2023–2025)",
  "Associated Student Body — President (2024–2025), Rallies Commissioner, Pride and Spirit Commissioner (2022–2025)",
  "Latin Student Alliance — Historian, Founding Member (2022–2025)",
  "Track and Field — Team Captain, Social Media Manager (2021–2025)",
  "Class Cabinet (2021–2025)",
  "Redeemed Life Church — Media Ministry, Youth Group Leader (2020–2025)",
  "Bithiah's Family Services (2014–Present)",
  "Girl Scouts (2012–Present)",
];

const coverage = [
  {
    title: "Faith, Code, and Community in APU's Computer Science Degree",
    outlet: "Azusa Pacific University",
    meta: "Azusa Pacific University · June 2026 · by Bella Youssefian",
    quote: "We're creating software where students in rural Uganda can build resumes without power or internet access.",
    body: "Published while I was actively building the Uganda project, this is the most current and most technical coverage: I'm quoted directly on the engineering work itself, not just my advocacy history.",
    href: "https://www.apu.edu/articles/faith-code-and-community-in-apu-s-computer-science-degree/",
  },
  {
    title: "Students make a difference at the school",
    outlet: "the hoofprint",
    meta: "the hoofprint · November 2024 · by Lydia Chen",
    body: "Coverage of student organizations' role in school decision-making. I'm pictured and named as the ASB representative alongside leaders from Student Think Tank, Peer Counseling, and Publications.",
    href: "https://whshoofprint.com/3459/news/students-make-a-difference-at-the-school/",
  },
  {
    title: "California approves new District of Choice bill",
    outlet: "the hoofprint",
    meta: "the hoofprint · October 2024 · by Antra Shah",
    body: "Coverage of SB 897 being signed into law, confirming Walnut Valley had more District of Choice students than any district in California.",
    href: "https://whshoofprint.com/3215/news/california-approves-new-district-of-choice-bill/",
  },
  {
    title: "WHS Holds First Student Think Tank of the Year",
    outlet: "the hoofprint",
    meta: "the hoofprint · October 2024 · by Trae Contryman",
    quote: "I think a lot of other people were excited as well because there's so many people at Think Tank this year, way bigger than last year.",
    body: "I'm quoted as ASB president and Think Tank member.",
    href: "https://whshoofprint.com/3145/news/whs-holds-first-student-think-tank-of-the-year/",
  },
  {
    title: "Getting to Know District of Choice",
    outlet: "Diamond Bar-Walnut Patch",
    meta: "Diamond Bar-Walnut Patch · April 2024 · by Kelli Gile",
    quote: "The District of Choice program has opened countless doors for me. I push myself every day to be a better student and person because I know that I have been given an incredible opportunity.",
    body: "I'm featured as the student voice for California's District of Choice program, the same program SB 897 later made permanent.",
    href: "https://patch.com/california/diamondbar-walnut/getting-know-district-choice",
  },
];
---

<section class="relative overflow-hidden">
  <Image
    src={awardsBg}
    alt=""
    widths={[800, 1600, 2400]}
    sizes="100vw"
    data-parallax
    class="absolute inset-0 h-full w-full object-cover object-[50%_30%] grayscale blur-[1px]"
  />
  <div class="absolute inset-0" style="background-color: rgba(250, 247, 238, 0.8);"></div>

  <div class="relative mx-auto max-w-3xl px-6 py-20">
    <h1 class="reveal font-display text-3xl font-normal text-navy-950">Recognition</h1>

    <!-- Full awards list dropdown -->
    <details class="reveal group mt-8 rounded-xl border border-navy-950/15 bg-white">
      <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-4 [&::-webkit-details-marker]:hidden">
        <span class="font-display text-base font-normal text-navy-950">See all awards, honors &amp; leadership</span>
        <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5 shrink-0 text-navy-800 transition-transform group-open:rotate-180" aria-hidden="true">
          <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <div class="border-t border-navy-950/10 px-6 pb-6 pt-4">
        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <h2 class="font-display text-base font-normal text-navy-950">Awards &amp; Honors</h2>
            <ul class="mt-3 space-y-2 text-sm text-navy-800">
              {fullAwards.map((item) => (
                <li>
                  {item.href ? (
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline decoration-sage-500 underline-offset-2 hover:text-sage-700"
                    >
                      {item.label}
                    </a>
                  ) : (
                    item.label
                  )}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h2 class="font-display text-base font-normal text-navy-950">Extracurricular &amp; Leadership</h2>
            <ul class="mt-3 space-y-2 text-sm text-navy-800">
              {fullExtracurriculars.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </details>

    <!-- Featured awards -->
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {featured.map((award, i) => (
        <div class={`reveal card-lift rounded-xl border border-navy-950/15 bg-white p-6${i % 2 === 1 ? " reveal-d2" : ""}`}>
          <h2 class="font-display text-lg font-normal text-navy-950">
            {award.href ? (
              <a
                href={award.href}
                target={award.external ? "_blank" : undefined}
                rel={award.external ? "noopener noreferrer" : undefined}
                class="hover:text-sage-500"
              >
                {award.title} {award.external && <span class="text-sage-500 text-sm">↗</span>}
              </a>
            ) : (
              award.title
            )}
          </h2>
          <p class="mt-2 text-sm text-navy-800">{award.body}</p>
          <div class="mt-3 flex flex-wrap gap-4">
            {award.advocacy && (
              <a
                href={award.advocacy}
                class="text-sm text-sage-700 underline decoration-sage-500 underline-offset-2 hover:text-navy-950"
              >
                About my project
              </a>
            )}
            {award.youtube && (
              <a
                href={award.youtube}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-sage-700 underline decoration-sage-500 underline-offset-2 hover:text-navy-950"
              >
                Watch on YouTube ↗
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Press -->
    <h2 class="reveal mt-16 font-display text-2xl font-normal text-navy-950">Press</h2>

    <div class="mt-8 space-y-14">
      {coverage.map((item, i) => (
        <article class="reveal" style={`transition-delay:${i * 0.08}s`}>
          <h3 class="font-display text-xl font-normal text-navy-950">
            <a
              href={item.href}
              class="hover:text-sage-500"
              target="_blank"
              rel="noopener noreferrer"
            >
              {item.title}
            </a>
          </h3>
          <p class="mt-1 text-sm text-sage-700">{item.meta}</p>
          {item.quote && (
            <blockquote class="mt-4 border-l-2 border-sage-500 pl-4 font-display italic text-navy-950">
              "{item.quote}"
            </blockquote>
          )}
          <p class="mt-4 text-navy-800">{item.body}</p>
        </article>
      ))}
    </div>

    <p class="mt-14 text-sm text-navy-800/70">
      Also covered: 1st place, Walnut Valley Water District Media Contest, Walnut High School news (2022).{" "}
      <a
        href="https://www.walnuths.net/apps/news/article/1764266"
        class="underline decoration-sage-500 underline-offset-2 hover:text-sage-700"
        target="_blank"
        rel="noopener noreferrer"
      >Read the writeup</a>.
    </p>
  </div>
</section>
