---
import { Image } from "astro:assets";
import heroPhoto from "../../assets/photos/hero-headshot.jpg";
---

<section class="hero" id="main-content">
  <!-- decorative shapes -->
  <div class="hero-shape shape-one" aria-hidden="true"></div>
  <div class="hero-shape shape-two" aria-hidden="true"></div>

  <div class="hero-copy">
    <p class="eyebrow">Advocate &amp; Engineer</p>

    <h1>
      Code that<br/>
      <em>moves people</em><br/>
      forward.
    </h1>

    <p>
      Humanitarian technologist building offline-first infrastructure, testifying before the California Legislature, and engineering systems that reach the people mainstream tech overlooks.
    </p>

    <div class="hero-actions">
      <a href="/work" class="primary-button">
        View my work
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2.5 7h9M7 2.5L11.5 7 7 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/contact" class="secondary-button">Get in touch</a>
    </div>

    <div class="impact-note">
      <span>Impact so far</span>
      <p>
        My work has reached <strong>700+ macOS endpoints audited</strong>, informed systems connecting <strong>75+ global organizations</strong>, and carried me across <strong>three continents</strong>.
      </p>
    </div>
  </div>

  <div class="hero-visual">
    <div class="photo-frame">
      <Image
        src={heroPhoto}
        alt="Pitzil Avila-Castellanos at the Linux Foundation Open Source Summit"
        width={1020}
        height={1020}
        loading="eager"
      />
    </div>
  </div>
</section>
